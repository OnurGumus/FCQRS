source https://api.nuget.org/v3/index.json

storage: none
framework: net9.0, net10.0

nuget FSharp.Core >= 10.1.201
nuget FSharp.Interop.Dynamic >= 5.0.1.268
nuget Microsoft.Extensions.Configuration >= 9.0.10
nuget Microsoft.Extensions.Logging.Console >= 9.0.10
nuget Microsoft.Extensions.Hosting.Abstractions >= 9.0.0
nuget Microsoft.Data.SQLite >= 9.0.10
nuget Akka.Cluster.Sharding >= 1.5.75
nuget Akka.Cluster.Tools >= 1.5.75
nuget Akka.Persistence.Sql >= 1.5.73 < 1.6
// Listed directly, though Akka.Persistence.Sql brings them: it asks for 1.5.73, and NuGet would
// give an application that version, older than the 1.5.75 FCQRS is compiled against.
nuget Akka.Persistence.Query >= 1.5.75
nuget Akka.Streams >= 1.5.75
nuget Akka.TestKit >= 1.5.75
nuget Akkling.Cluster.Sharding >= 0.18.1
nuget Akkling.Persistence >= 0.18.1
nuget Akkling.Streams >= 0.18.1
nuget FSharp.SystemTextJson >= 1.4.36
nuget FsToolkit.ErrorHandling >= 5.1.0
nuget Hocon.Extensions.Configuration >= 2.0.4
nuget FCQRS.Serialization >= 6.1.0
nuget FCQRS.Model >= 6.1.0
nuget FCQRS
nuget SQLProvider
nuget SQLitePCLRaw.core
nuget Fable.Package.SDK
nuget Expecto
nuget TickSpec
nuget Serilog >= 4.2.0
nuget Serilog.Sinks.Seq >= 9.0.0
nuget Serilog.Sinks.Console >= 6.0.0
nuget Serilog.Extensions.Logging >= 8.0.0 < 10.0.0
nuget SerilogTracing
nuget SerilogTracing.Sinks.Seq
nuget linq2db 6.5.1
