<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The account and statement of step 5, which a workflow and a saga can both drive. -->
    <Compile Include="../../5-transfer-money/fsharp/Account.fs" Link="Account.fs" />
    <Compile Include="../../5-transfer-money/fsharp/Statement.fs" Link="Statement.fs" />
    <Compile Include="Transfer.fs" />
    <Compile Include="Program.fs" />
    <PackageReference Include="FCQRS" Version="7.5.1" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
  </ItemGroup>
</Project>
