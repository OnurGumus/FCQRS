<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Version>7.0.0</Version>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FCQRS.Workflows</PackageId>
    <Description>Durable workflows for FCQRS: straight-line code whose step results are journaled and replayed on recovery.</Description>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <IncludeSource>true</IncludeSource>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/onurgumus/FCQRS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Journal.fs" />
    <Compile Include="Workflow.fs" />
    <Compile Include="Machine.fs" />
    <Compile Include="Messages.fs" />
    <Compile Include="WorkflowActor.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Children.fs" />
    <Compile Include="Streams.fs" />
    <Compile Include="CSharp.fs" />
    <Content Include="paket.references" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Facade.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FCQRS\FCQRS.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
