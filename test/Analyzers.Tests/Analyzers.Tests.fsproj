<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" Version="10.*" />
    <PackageReference Include="FSharp.Analyzers.SDK" Version="0.43.0" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.13.404" />
    <PackageReference Update="FSharp.Core" Version="10.1.404" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <ProjectReference Include="..\..\src\FCQRS.Analyzers\FCQRS.Analyzers.fsproj" />
    <ProjectReference Include="..\..\src\FCQRS.Analyzers.CSharp\FCQRS.Analyzers.CSharp.csproj" />
    <!-- The programs under test reference these assemblies. -->
    <ProjectReference Include="..\..\src\FCQRS.Workflows\FCQRS.Workflows.fsproj" />
  </ItemGroup>
</Project>
