<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- override the repo Directory.Build.props (docs are for the library, not this test) -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="VerifySerialization.fs" />
    <Compile Include="BridgeSteps.fs" />
    <Compile Include="CommandSubscriptionTests.fs" />
    <Compile Include="SagaHandshakeTests.fs" />
    <Compile Include="SagaLifecycleTests.fs" />
    <Compile Include="ProjectionSubscriptionTests.fs" />
    <Compile Include="ProjectionCatchUpTests.fs" />
    <Compile Include="ExpectedVersionTests.fs" />
    <Compile Include="ConditionalCommandSerializationTests.fs" />
    <Compile Include="EventUpcastingTests.fs" />
    <Compile Include="HostingAndRegistryTests.fs" />
    <Compile Include="UnionAttribute.fs" />
    <Compile Include="UnionCommandTests.fs" />
    <Compile Include="JournalRejectionTests.fs" />
    <!-- The tutorial's bank from step 5, compiled as the reader runs it. -->
    <Compile Include="..\..\samples\accounts\5-transfer-money\fsharp\Account.fs" Link="Bank\Account.fs" />
    <Compile Include="..\..\samples\accounts\5-transfer-money\fsharp\Transfer.fs" Link="Bank\Transfer.fs" />
    <Compile Include="BankInvariantTests.fs" />
    <Compile Include="SagaStartOnceTests.fs" />
    <Compile Include="Tests.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="bridge.feature" LogicalName="Facade.bridge.feature" />
    <EmbeddedResource Include="pending.feature" LogicalName="Facade.pending.feature" />
    <EmbeddedResource Include="focused.feature" LogicalName="Facade.focused.feature" />
  </ItemGroup>

  <!-- Smoke-tests the FCQRS.FSharp facade end to end against the current source. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FCQRS\FCQRS.fsproj" />
    <ProjectReference Include="..\..\src\FCQRS.Model\FCQRS.Model.fsproj" />
    <ProjectReference Include="..\..\src\FCQRS.ExpectoTickSpec\FCQRS.ExpectoTickSpec.fsproj" />
    <PackageReference Include="Expecto" Version="10.*" />
    <PackageReference Include="TickSpec" Version="2.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
