<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiled to JavaScript by Fable and run by Node in CI: python3 scripts/check-fable.py.
       It checks that FCQRS.Model compiles under Fable and that a free program runs the same
       there. A .NET build is not used. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FCQRS.Model\FCQRS.Model.fsproj" />
  </ItemGroup>
</Project>
